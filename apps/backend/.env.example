RUST_LOG=info,tower_http=info
API_BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://encyclopedia:encyclopedia@localhost:5432/encyclopedia
REDIS_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=sourcepedia_chunks
QDRANT_VECTOR_SIZE=256
TANTIVY_INDEX_DIR=var/tantivy
WIKIPEDIA_DUMP_PATH=enwiki-latest-pages-articles-multistream.xml.bz2
ARCHWIKI_HTML_DIR=/usr/share/doc/arch-wiki/html/en
REDIS_EMBED_QUEUE_KEY=sourcepedia:embedding_jobs
REDIS_CACHE_TTL_SECONDS=120
DEMO_FIXTURE_PATH=data/demo/documents.json
EMBEDDING_PROVIDER=hash
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=180
SEARCH_RESULT_LIMIT=8
QDRANT_SEARCH_LIMIT=16
TANTIVY_SEARCH_LIMIT=16
LLM_PROVIDER=extractive
