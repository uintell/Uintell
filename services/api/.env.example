ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uintell
REDIS_URL=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
MEILISEARCH_URL=
MEILISEARCH_INDEX=documents

TEMPORAL_HOST=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=knowledge-ingestion

FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/uintell/storage
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
GENERATION_PROVIDER=deterministic
EMBEDDING_PROVIDER=hash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=256
OPENAI_TEMPERATURE=0.2
ENABLE_OPENAI_GENERATION=false
ENABLE_TOOL_CALLING=true

AUTH_COOKIE_NAME=uintell_session
SESSION_TTL_HOURS=336
SECURE_COOKIES=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=20971520

RAG_TOP_K=6
RAG_CONTEXT_CHAR_LIMIT=12000
RETRIEVAL_FUSION_LIMIT=12

WIKIPEDIA_DUMP_PATH=/data/uintell/imports/wikipedia/enwiki-latest-pages-articles-multistream.xml.bz2
ARCHWIKI_ROOT=/data/uintell/imports/archwiki/html
LOCAL_DOCS_ROOT=/workspace/data/local-docs

OTLP_ENDPOINT=
OTEL_SERVICE_NAME=uintell-api

SEED_ADMIN_EMAIL=admin@uintell.org
SEED_ADMIN_PASSWORD=change-me-before-running
