[Unit]
Description=Sourcepedia infra Docker Compose stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/x1/projectx
Environment=COMPOSE_PROJECT_NAME=sourcepedia
ExecStart=/usr/bin/docker compose up -d postgres redis qdrant temporal temporal-ui
ExecStop=/usr/bin/docker compose stop temporal-ui temporal qdrant redis postgres
ExecReload=/usr/bin/docker compose up -d postgres redis qdrant temporal temporal-ui
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
