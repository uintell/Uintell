[Unit]
Description=Sourcepedia ingestion worker
After=network-online.target docker.service sourcepedia-api.service
Wants=network-online.target

[Service]
Type=simple
User=x1
WorkingDirectory=/home/x1/projectx/services/worker
EnvironmentFile=-/etc/uintell/sourcepedia.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/x1/projectx/.venv-prod/bin/python -m worker_app.main
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
